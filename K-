using System;

class ProgramK
{
    static void Main()
    {
        int soma = 0;
        int numero;

        do
        {
            Console.Write("Digite um número inteiro: ");
            numero = int.Parse(Console.ReadLine());

            if (numero >= 0)
            {
                soma += numero;
            }

        } while (numero >= 0);

        Console.WriteLine("A soma dos números é: " + soma);
    }
}
